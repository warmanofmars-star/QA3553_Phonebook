# ============================================================
# Шаблон переменных окружения.
# Скопируй этот файл в .env и заполни своими значениями:
#     cp .env.example .env        (Linux / Git Bash)
#     copy .env.example .env      (Windows cmd / PowerShell)
# Сам .env в git не попадает (см. .gitignore). Этот шаблон — попадает.
# Все переменные описаны в config.py.
# ============================================================

# --- Тестируемое приложение ---
BASE_URL=https://telranedu.web.app
API_URL=https://contactapp-telran-backend.herokuapp.com

# --- Постоянный пользователь (нужен части UI-тестов) ---
USER_EMAIL=your_email@example.com
USER_PASSWORD=change_me

# --- Запуск браузеров ---
HEADLESS_MODE=false
# true — браузеры в Selenium Grid (docker-compose.yml), false — на этой машине
USE_GRID=false
# GRID_URL=http://localhost:4444
# Какие узлы браузеров запускает docker compose (chrome / firefox / edge).
# Нужна только для запуска через docker compose; тесты её не читают
COMPOSE_PROFILES=chrome
# Папка с видео сессий. Задаётся в docker-compose.yml (/app/video);
# при локальном запуске не нужна — видео лежит внутри Docker-тома
# VIDEO_DIR=

# --- Таймауты ---
# UI_TIMEOUT=5
PW_TIMEOUT=10000
