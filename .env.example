# ============================================================
# Шаблон переменных окружения.
# Скопируй этот файл в .env и заполни своими значениями:
#     cp .env.example .env        (Linux / Git Bash)
#     copy .env.example .env      (Windows cmd / PowerShell)
# Сам .env в git не попадает (см. .gitignore). Этот шаблон — попадает.
# Все переменные описаны в config.py.
# ============================================================

# --- Тестируемое приложение ---
BASE_URL=https://telranedu.web.app
API_URL=https://contactapp-telran-backend.herokuapp.com

# --- Постоянный пользователь (нужен части UI-тестов) ---
USER_EMAIL=your_email@example.com
USER_PASSWORD=change_me

# --- Запуск браузеров ---
HEADLESS_MODE=false
USE_SELENOID=false
# SELENOID_HUB_URL=http://localhost:4444/wd/hub
# VIDEO_DIR=C:\selenoid\video

# --- Таймауты ---
# UI_TIMEOUT=5
PW_TIMEOUT=10000

# --- Поведение фреймворка ---
ENABLE_CONSOLE_LOGS=true
