# Jenkins с Docker CLI внутри: сборки запускают docker compose через сокет
# Docker хост-машины (см. docker-compose.jenkins.yml).
#
# ВЕРСИЯ закреплена явно. Обновлять — правкой тега в строке FROM и пересборкой
# (docker compose -f docker-compose.jenkins.yml up -d --build), а НЕ кнопкой
# "обновить автоматически" в интерфейсе Jenkins: она обновит Jenkins только внутри
# контейнера, и при следующей пересборке он откатится к версии из этого файла.
# Обновлять только вперёд: откат с уже обновлённым jenkins_home может сломать
# конфигурацию.
FROM jenkins/jenkins:2.580.2-lts-jdk21

USER root

# Docker CLI и плагин compose из официального репозитория Docker.
# Одним RUN-слоем и с очисткой кэша apt — образ получается меньше.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Образ по умолчанию работает от пользователя jenkins. Но docker-compose.jenkins.yml
# всё равно запускает контейнер от root (user: root) — иначе нет доступа к docker.sock.
# Для учебного локального стенда это допустимо; в реальной инфраструктуре так не делают:
# root в контейнере с docker.sock фактически означает root на всей хост-машине.
USER jenkins
